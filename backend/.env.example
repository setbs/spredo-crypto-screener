# live (default) fetches CoinGecko. demo uses explicitly synthetic local fixtures.
DATA_MODE=live

# A free Demo API key is recommended. Keep this file server-side.
COINGECKO_API_KEY=
COINGECKO_API_TIER=demo

# The complete scan runs in the background; the UI polls its progress.
# No market-page or detail-request truncation is applied.
CACHE_TTL_SECONDS=3600
# Keyless requests have an additional minimum interval of 2.1 seconds.
REQUEST_INTERVAL_SECONDS=0.75
