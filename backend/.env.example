# live (default) fetches CoinGecko. demo uses explicitly synthetic local fixtures.
DATA_MODE=live

# A free Demo API key is recommended. Keep this file server-side.
COINGECKO_API_KEY=
COINGECKO_API_TIER=demo

# A bounded scan keeps the first response practical on the free API.
# Increase these for wider coverage; limits are reported in response metadata.
MARKET_PAGES=4
MAX_DETAIL_REQUESTS=25
CACHE_TTL_SECONDS=300
REQUEST_INTERVAL_SECONDS=2.1
